            "duration": {
              "default": 0.0,
              "title": "Duration",
              "type": "number"
            },
            "text": {
              "title": "Text",
              "type": "string"
            }
          },
          "required": [
            "start",
            "text"
          ],
          "title": "TranscriptSegment",
          "type": "object"
        }
      },
      "description": "Au moins un de video_id / url / transcript doit être fourni.",
