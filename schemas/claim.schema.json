        "date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Date du discours AAAA-MM-JJ",
          "title": "Date"
        },
        "categories": {
          "default": [
            "emploi"
          ],
          "items": {
            "$ref": "#/$defs/Category"
          },
          "title": "Categories",
          "type": "array"
        },
        "use_web": {
          "default": true,
          "title": "Use Web",
          "type": "boolean"
        },
        "force": {
          "default": false,
          "description": "Ré-analyser même si déjà en base",
          "title": "Force",
          "type": "boolean"
        }
      },
      "required": [
        "speaker"
      ],
      "title": "AnalyzeRequest",
      "type": "object"
    },
