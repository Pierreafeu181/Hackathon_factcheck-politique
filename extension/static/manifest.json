{
  "manifest_version": 3,
  "name": "Vérif'Pol",
  "version": "1.0.1",
  "description": "Vérifie les affirmations des responsables politiques français, sources officielles à l'appui.",
  "action": {
    "default_title": "Vérif'Pol",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "contextMenus",
    "scripting",
    "storage",
    "tabs",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "direct": {
      "suggested_key": {
        "default": "Alt+Shift+L"
      },
      "description": "Vérifier en direct le son de l'onglet"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "homepage_url": "https://01a16824-5586-7784-b544-269ed9694450-8080.eur-1.aiven.app/privacy"
}
