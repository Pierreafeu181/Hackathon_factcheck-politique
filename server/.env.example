# Port du serveur (l'extension pointe sur http://localhost:8790 par défaut)
PORT=8790

# Clé Deepgram (200 $ offerts à l'inscription sur console.deepgram.com).
# Sans clé, la veille liste les épisodes mais ne les transcrit pas.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# URL du moteur d'analyse de l'équipe (reçoit un CheckRequest en POST, renvoie un CheckResponse).
# Vide = faux moteur de démo intégré.
CHECKER_URL=

# Fréquence de la veille RSS, et nombre d'épisodes récents traités par flux
# (évite de transcrire tout l'historique au premier lancement).
POLL_MINUTES=15
MAX_EPISODES_PER_FEED=1
