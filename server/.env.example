# Port du serveur (l'extension pointe sur http://localhost:8790 par défaut)
PORT=8790

# Clé Deepgram (200 $ offerts à l'inscription sur console.deepgram.com).
# Sans clé, la veille liste les épisodes mais ne les transcrit pas.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# URL du moteur d'analyse de l'équipe (reçoit un CheckRequest en POST, renvoie un CheckResponse).
# Vide = faux moteur de démo intégré.
# Moteur Python du repo (backend/) : CHECKER_URL=http://localhost:8000/check
CHECKER_URL=

# Fréquence de la veille RSS, et nombre d'épisodes récents traités par flux
# (évite de transcrire tout l'historique au premier lancement).
POLL_MINUTES=15
MAX_EPISODES_PER_FEED=1
# Chemin de yt-dlp (vidéos sans sous-titres, TikTok, Reels, X… → audio → Deepgram). Défaut : yt-dlp dans le PATH (brew install yt-dlp ffmpeg)
# YTDLP_PATH=/opt/homebrew/bin/yt-dlp
# Instagram, Facebook… demandent souvent un compte connecté. Pour réutiliser la session d'un navigateur de CE Mac
# (yt-dlp lit ses cookies ; à n'activer que sur votre propre machine) : chrome, firefox, safari, brave…
# YTDLP_COOKIES_FROM_BROWSER=chrome
