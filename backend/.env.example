# Copier en .env (jamais commité)
ANTHROPIC_API_KEY=sk-ant-...
# Modèle (défaut claude-opus-5-5). Ex. pour aller plus vite / moins cher : claude-sonnet-5-5
LLM_MODEL=claude-opus-5-5
# Chemin de la base SQLite (défaut backend/factcheck.db)
# DB_PATH=./factcheck.db
# Google Fact Check Tools (fact-checks déjà publiés, interrogés en premier). Sans clé : étape sautée.
GOOGLE_FACTCHECK_API_KEY=
