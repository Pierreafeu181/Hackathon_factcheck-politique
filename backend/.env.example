# Copier en .env (jamais commité)
# Modèle : Gemini (offre gratuite) par défaut. Clé gratuite : https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite     # secours : GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite (gemini-3.8-flash : 20 req/jour en gratuit)
# GEMINI_EXTRACT_MODEL=gemini-3.8-flash   # extraction seulement (20 req/jour), vide = même modèle que le reste
# GEMINI_MAX_PARALLEL=2        # appels simultanés (l'offre gratuite est plafonnée par minute)
# Mistral (offre gratuite « Experiment », https://console.mistral.ai) : prioritaire dès que la clé est définie,
# Gemini sert alors de secours si Mistral refuse (quota, panne). Forcer un fournisseur : LLM_PROVIDER=gemini|mistral|anthropic
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-medium-latest   # ou mistral-large-latest
# Claude (optionnel, payant) : LLM_PROVIDER=anthropic + clé
# ANTHROPIC_API_KEY=sk-ant-...
# Sources à clé (gratuites, facultatives) : fact-checks publiés (Google) et Légifrance (portail PISTE)
# GOOGLE_FACTCHECK_API_KEY=
# PISTE_CLIENT_ID=
# PISTE_CLIENT_SECRET=
# LLM_MODEL=claude-sonnet-5-5   # seulement si LLM_PROVIDER=anthropic
# Chemin de la base SQLite (défaut backend/factcheck.db)
# DB_PATH=./factcheck.db
# Base PostgreSQL (Aiven : console → service → Overview → Service URI). Vide = SQLite.
# DATABASE_URL=postgres://avnadmin:...@....aivencloud.com:12345/defaultdb?sslmode=require
